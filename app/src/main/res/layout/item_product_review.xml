<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_border_bottom_gray">

    <!-- User Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_user_placeholder"
            android:background="@drawable/bg_circle_gray"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#FFC107"/>
                
                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:layout_marginStart="4dp"/>
                    
                <View
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:background="#CCCCCC"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                    
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20/12/2023"
                    android:textSize="12sp"
                    android:textColor="#999999"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amazing Product!"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Really loved this product. The quality is top notch and fits perfectly."
        android:textColor="#333333"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"/>

    <!-- Horizontal Image List -->
    <LinearLayout
        android:id="@+id/llReviewImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone">
        
        <!-- Images dynamically added here -->
    </LinearLayout>
    
    <!-- Admin Reply -->
    <LinearLayout
        android:id="@+id/llAdminReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phản hồi từ Người bán"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/black"/>
            
        <TextView
            android:id="@+id/tvAdminReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cảm ơn bạn đã đánh giá!"
            android:textColor="#555555"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
