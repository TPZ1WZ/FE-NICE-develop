<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:backgroundTint="@color/white">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bộ lọc"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="500dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <!-- 1. Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="8dp"/>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="10000000"
                    android:stepSize="50000"
                    app:trackColorActive="@color/black"
                    app:trackColorInactive="#E0E0E0"
                    app:thumbColor="@color/black"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/tvMinPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0đ" android:textColor="#757575"/>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvMaxPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10.000.000đ" android:textColor="#757575"/>
                </LinearLayout>

                <!-- 2. Size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kích cỡ"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacing="8dp"
                    app:selectionRequired="false">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="37"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="37.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="41"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="43"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="44"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="44.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45.5"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="46"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="47"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                </com.google.android.material.chip.ChipGroup>


                <!-- 6. Sort By -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sắp xếp theo"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacing="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mới nhất"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bán chạy nhất"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá: Thấp đến Cao"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá: Cao đến Thấp"
                        android:textColor="@color/text_chip_selector"
                        app:chipBackgroundColor="@color/bg_chip_selector"
                        app:chipStrokeWidth="0dp"
                        app:chipCornerRadius="12dp"/>
                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    <!-- Apply Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Đặt lại"
            android:textColor="@color/white"
            android:backgroundTint="@color/black"/>

        <Button
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Áp dụng"
            android:textColor="@color/white"
            android:backgroundTint="@color/black"/>

    </LinearLayout>

</LinearLayout>