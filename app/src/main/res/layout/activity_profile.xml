<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#F7F7F9"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black"
            android:padding="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>
    </RelativeLayout>

    <!-- Avatar Section -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/img_placeholder_shoe"
            app:civ_border_width="0dp"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_edit"
            app:tint="@color/white"
            android:padding="4dp"
            android:background="@drawable/bg_blue_circle"
            android:layout_margin="4dp"/>
    </FrameLayout>

    <!-- Inputs -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Name"
        android:textColor="@color/gray_500"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_profile"
        android:paddingHorizontal="16dp"
        android:text="EMMANUEL OYIBOKE"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/gray_500"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_profile"
        android:paddingHorizontal="16dp"
        android:text="emmanueloyiboke@gmail.com"
        android:inputType="textEmailAddress"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/gray_500"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_profile"
        android:paddingHorizontal="16dp"
        android:text="........"
        android:inputType="textPassword"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Recovery Password"
        android:textColor="@color/gray_500"
        android:textSize="12sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Now"
        android:textAllCaps="false"
        android:backgroundTint="@color/splash_blue"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAdminDashboard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Admin Dashboard"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:backgroundTint="#4CAF50"
        app:cornerRadius="12dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/tvLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Sign Out"
        android:textColor="#EF4444"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="8dp"/>

</LinearLayout>
