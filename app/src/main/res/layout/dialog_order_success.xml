<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="516dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="48dp">

            <!-- Icon Container -->

            <!-- Decorative Dots -->
            <!-- Top Left -->

            <FrameLayout
                android:id="@+id/container_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_black_shape"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cart Icon"
                    android:src="@drawable/ic_shopping_bag"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_circle_black_shape"
                app:layout_constraintBottom_toTopOf="@+id/container_icon"
                app:layout_constraintEnd_toStartOf="@+id/container_icon" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dot_gray"
                app:layout_constraintBottom_toTopOf="@+id/container_icon"
                app:layout_constraintEnd_toStartOf="@+id/container_icon" />

            <!-- Top Right -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dot_gray"
                app:layout_constraintStart_toEndOf="@+id/container_icon"
                app:layout_constraintTop_toTopOf="@+id/container_icon" />


            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="-10dp"
                android:background="@drawable/bg_circle_black_shape"
                app:layout_constraintStart_toEndOf="@+id/container_icon"
                app:layout_constraintTop_toTopOf="@+id/container_icon" />

            <!-- Bottom Left -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dot_gray"
                app:layout_constraintBottom_toBottomOf="@+id/container_icon"
                app:layout_constraintEnd_toStartOf="@+id/container_icon" />

            <!-- Bottom Right -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_dot_gray"
                app:layout_constraintBottom_toBottomOf="@+id/container_icon"
                app:layout_constraintStart_toEndOf="@+id/container_icon" />


            <TextView
                android:id="@+id/tv_success_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Đặt hàng thành công!"
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/container_icon" />

            <TextView
                android:id="@+id/tv_success_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Đơn hàng của bạn đã được tạo thành công."
                android:textColor="#555555"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_success_title" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_view_order"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/btn_rounded_black"
                android:text="Xem đơn hàng"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_success_desc" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Về trang chủ"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_view_order" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
