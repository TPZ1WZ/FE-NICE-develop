<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:background="@android:color/white">

        <!-- Icon/Animation hiệu ứng -->
        <TextView
            android:id="@+id/tvResultIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="60sp"
            android:layout_marginBottom="16dp" />

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chúc mừng bạn!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center" />

        <!-- Tên phần thưởng -->
        <TextView
            android:id="@+id/tvPrizeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn đã trúng Voucher Giảm 20%"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Mã code với background đẹp hơn -->
        <LinearLayout
            android:id="@+id/layoutPrizeCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_light"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:visibility="visible">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã voucher của bạn:"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_gravity="center" />
                
            <TextView
                android:id="@+id/tvPrizeCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VCABC12345"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Nút hành động -->
        <Button
            android:id="@+id/btnUseNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ DÙNG NGAY"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="24dp"
            android:visibility="visible" />

        <Button
            android:id="@+id/btnSaveToWallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Lưu vào ví voucher"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/green_800"
            android:layout_marginTop="12dp"
            android:visibility="visible" />

        <!-- Nút đóng (cho trường hợp không trúng) -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ĐÓNG"
            android:textStyle="bold"
            android:backgroundTint="@color/gray_600"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
