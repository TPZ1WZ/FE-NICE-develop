<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔 Test Notification Badge"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="32dp" />

    <!-- Notification Badge View -->
    <com.example.nike_fe.NotificationBadgeView
        android:id="@+id/notification_badge_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp" />

    <!-- Test Buttons -->
    <Button
        android:id="@+id/btn_test_api"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Test API Thật (GET /api/notifications/count-unread)"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/btn_simulate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simulate Random Count"
        android:textAllCaps="false"
        android:backgroundTint="#2196F3" />

    <!-- Status Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:text="Hướng dẫn:\n\n1️⃣ Test API Thật: Gọi backend lấy số thông báo chưa đọc thật\n\n2️⃣ Simulate: Tạo số random để test giao diện\n\n3️⃣ Click vào chuông để xem số thông báo hiện tại"
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
