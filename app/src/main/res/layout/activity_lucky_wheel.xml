<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        app:title="Vòng Quay May Mắn"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 QUAY NGAY - TRÚNG LỚN 🎉"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="20dp" />

            <!-- Số lượt còn lại -->
            <TextView
                android:id="@+id/tvRemainingSpins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn còn 1 lượt quay hôm nay"
                android:textSize="16sp"
                android:textColor="#6B7280"
                android:layout_marginTop="10dp" />

            <!-- Hướng dẫn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Mỗi ngày chỉ được quay 1 lần • Chỉ dành cho user đã đăng nhập"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginTop="5dp" />

            <!-- Mô tả / Thông báo sự kiện -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF3E0">

                <TextView
                    android:id="@+id/tvEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="sinh nhật"
                    android:textSize="14sp"
                    android:textColor="#E65100"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>

            <!-- Vòng quay với 6 phần thưởng -->
            <FrameLayout
                android:layout_width="340dp"
                android:layout_height="340dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center">

                <!-- Custom Wheel View -->
                <com.example.nike_fe.ui.luckywheel.LuckyWheelView
                    android:id="@+id/wheelView"
                    android:layout_width="340dp"
                    android:layout_height="340dp"
                    android:layout_gravity="center" />

                <!-- Mũi tên chỉ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="40sp"
                    android:textColor="#FFD700"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-8dp" />
            </FrameLayout>

            <!-- Nút quay -->
            <Button
                android:id="@+id/btnSpin"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:text="QUAY NGAY"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:layout_marginTop="30dp" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- Nút xem lịch sử -->
            <Button
                android:id="@+id/btnViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Xem phần thưởng đã nhận"
                android:textSize="16sp"
                android:backgroundTint="#4B5563"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="20dp" />

            <!-- Danh sách phần thưởng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁 Phần thưởng hấp dẫn"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginTop="40dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPrizes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
