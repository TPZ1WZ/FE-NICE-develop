<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions để kết nối Backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permissions để truy cập ảnh -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nikefe"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">
        
        <!-- SplashActivity - Splash Screen (LAUNCHER) -->
        <activity
            android:name=".ui.intro.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- OnboardingActivity - Onboarding Screens -->
        <activity
            android:name=".ui.intro.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        
        <!-- LoginActivity - Màn hình đăng nhập -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- RegisterActivity - Màn hình đăng ký -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- VerifyOtpActivity - Màn hình xác thực OTP -->
        <activity
            android:name=".ui.auth.VerifyOtpActivity"
            android:exported="false" />
        
        <!-- ForgotPasswordActivity - Màn hình quên mật khẩu -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />
        
        <!-- ResetPasswordActivity - Màn hình đặt lại mật khẩu -->
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:exported="false" />
        
        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Nikefe" />
        
        <!-- ProductListActivity - Danh sách sản phẩm -->
        <activity
            android:name=".ui.product.ProductListActivity"
            android:exported="false" />
        
        <!-- ProductDetailActivity - Chi tiết sản phẩm -->
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false" />
        
        <!-- CartActivity - Giỏ hàng -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />
        
        <!-- CheckoutActivity - Thanh toán -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />
        
        <!-- ProfileActivity - Hồ sơ người dùng -->
        <activity
            android:name=".ui.product.AllProductsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        
        <!-- EditProfileActivity - Chỉnh sửa hồ sơ -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />
        
        <!-- OrderHistoryActivity - Lịch sử đơn hàng -->
        <activity
            android:name=".ui.order.OrderHistoryActivity"
            android:exported="false" />
        
        <!-- OrderDetailActivity - Chi tiết đơn hàng -->
        <activity
            android:name=".ui.order.OrderDetailActivity"
            android:exported="false" />
        
        <!-- FavoriteActivity - Danh sách yêu thích -->
        <activity
            android:name=".ui.favorite.FavoriteActivity"
            android:exported="false" />
        
        <!-- NotificationActivity - Thông báo -->
        <activity
            android:name=".ui.notification.NotificationActivity"
            android:exported="false" />
        
        <!-- SettingsActivity - Cài đặt -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        
        <!-- AdminDashboardActivity - Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        
        <!-- AdminProductsActivity - Admin Product Management -->
        <activity
            android:name=".ui.admin.AdminProductsActivity"
            android:exported="false" />
        
        <!-- AdminProductFormActivity - Add/Edit Product -->
        <activity
            android:name=".ui.admin.AdminProductFormActivity"
            android:exported="false" />
        
        <!-- AdminCategoriesActivity - Admin Category Management -->
        <activity
            android:name=".ui.admin.AdminCategoriesActivity"
            android:exported="false" />
        
        <!-- AdminCategoryFormActivity - Add/Edit Category -->
        <activity
            android:name=".ui.admin.AdminCategoryFormActivity"
            android:exported="false" />
        
        <!-- AdminOrdersActivity - Admin Order Management -->
        <activity
            android:name=".ui.admin.AdminOrdersActivity"
            android:exported="false" />
        
        <!-- AdminOrderDetailActivity - Order Detail with Actions -->
        <activity
            android:name=".ui.admin.AdminOrderDetailActivity"
            android:exported="false" />

        <!-- AdminUsersActivity - Admin User Management -->
        <activity
            android:name=".ui.admin.AdminUsersActivity"
            android:exported="false" />

        <!-- AdminUserDetailActivity - Admin User Detail -->
        <activity
            android:name=".ui.admin.AdminUserDetailActivity"
            android:exported="false" />

        <!-- AdminCouponsActivity - Admin Coupon Management -->
        <activity
            android:name=".ui.admin.AdminCouponsActivity"
            android:exported="false" />

        <!-- AdminCouponFormActivity - Add/Edit Coupon -->
        <activity
            android:name=".ui.admin.AdminCouponFormActivity"
            android:exported="false" />

        <!-- AdminReviewsActivity - Admin Review Management -->
        <activity
            android:name=".ui.admin.AdminReviewsActivity"
            android:exported="false"
            android:label="Quản lý Đánh giá"
            android:parentActivityName=".ui.admin.AdminDashboardActivity" />
            
        <!-- AdminSettingsActivity - Admin Settings -->
        <activity
            android:name=".ui.admin.AdminSettingsActivity"
            android:exported="false"
            android:label="Cài đặt Admin"
            android:parentActivityName=".ui.admin.AdminDashboardActivity" />
            
        <!-- OrderReviewActivity - User Review -->
        <activity
            android:name=".ui.order.OrderReviewActivity"
            android:exported="false" />
    </application>

</manifest>