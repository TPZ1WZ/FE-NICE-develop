<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions để kết nối Backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nikefe"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">
        
        <!-- LoginActivity - Màn hình đăng nhập (LAUNCHER) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity - Màn hình đăng ký -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        
        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        
        <!-- ProductListActivity - Danh sách sản phẩm -->
        <activity
            android:name=".ui.product.ProductListActivity"
            android:exported="false" />
        
        <!-- ProductDetailActivity - Chi tiết sản phẩm -->
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false" />
        
        <!-- CartActivity - Giỏ hàng -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />
        
        <!-- CheckoutActivity - Thanh toán -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />
        
        <!-- ProfileActivity - Hồ sơ người dùng -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />
        
        <!-- EditProfileActivity - Chỉnh sửa hồ sơ -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />
        
        <!-- OrderHistoryActivity - Lịch sử đơn hàng -->
        <activity
            android:name=".ui.order.OrderHistoryActivity"
            android:exported="false" />
        
        <!-- OrderDetailActivity - Chi tiết đơn hàng -->
        <activity
            android:name=".ui.order.OrderDetailActivity"
            android:exported="false" />
        
        <!-- AdminDashboardActivity - Admin Dashboard -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        
        <!-- AdminProductsActivity - Admin Product Management -->
        <activity
            android:name=".ui.admin.AdminProductsActivity"
            android:exported="false" />
        
        <!-- AdminProductFormActivity - Add/Edit Product -->
        <activity
            android:name=".ui.admin.AdminProductFormActivity"
            android:exported="false" />
    </application>

</manifest>